# Copy to .env and fill in for local development. Django reads these via
# os.environ (see config/settings.py) — none are required for `manage.py test`,
# which never needs real credentials.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=

# Week 6 — needed only for OpenWeatherMapProvider to make live calls
# (core/weather_provider.py). Free tier: https://openweathermap.org/api
# Tests use FakeWeatherProvider and never touch this.
OPENWEATHERMAP_API_KEY=

# Week 7 — needed only for AgmarknetProvider to make live calls
# (core/price_provider.py). Free registration: https://data.gov.in/user/register
# Without it, the API endpoint serves SampleMandiPriceProvider's fixed
# sample data instead (clearly flagged via is_sample_data in the response).
DATA_GOV_IN_API_KEY=

# Week 10 — NOT needed for the current SMS/voice fallback scope.
# core/sms_fallback_handler.py and the /api/sms|voice/webhook/ views only
# handle *incoming* Twilio webhooks (reply with TwiML), which needs zero
# credentials. TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN would only be needed
# if the app starts *proactively* sending SMS/calls (e.g. pushing a weather
# alert) — see docs/adr/0011-twilio-fallback-channels.md.
